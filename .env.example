# ── Egress ───────────────────────────────────────────────────────────────────
# MANDATORY. Defaults to proxy_only in code, which blocks the openai backend
# before any request is made.
LLM_EGRESS_POLICY=open

# ── LLM: OpenAI ──────────────────────────────────────────────────────────────
LLM_BACKEND=openai
# MANDATORY: the default value of this variable points at Groq, not OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=90

# Tier 1 gpt-4o-mini: 500 RPM but 200,000 TPM, and tokens bind first.
# A RAG call averaged 3,759 tokens here, so ~53 calls/min is the real ceiling.
LLM_RATE_LIMIT_RPS=0.8
LLM_MAX_CONCURRENCY=4

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# ── Embeddings: OpenAI (no fastembed install needed) ──────────────────────────
EMBED_BACKEND=openai
EMBED_DIM=1536 # MUST match text-embedding-3-small
EMBED_OPENAI_MODEL=text-embedding-3-small
# EMBED_OPENAI_API_KEY is unset on purpose: it falls back to OPENAI_API_KEY.
# EMBED_OPENAI_BASE_URL already defaults to https://api.openai.com/v1.

EMBED_BATCH_SIZE=50
# Tier 1 embeddings: 1M TPM. A 50-text batch is ~7.5k tokens -> ~130 req/min.
EMBED_RATE_LIMIT_RPS=2
EMBED_MAX_CONCURRENCY=4

# ── Cost tracking (drives the Grafana cost panel) ─────────────────────────────
# gpt-4o-mini list price, USD per 1M tokens. Wrong values here do not affect
# behaviour, only the accuracy of the cumulative-cost chart.
COST_PROMPT_PER_1M=0.15
COST_COMPLETION_PER_1M=0.60

# ── Database ─────────────────────────────────────────────────────────────────
# Leave as localhost. docker-compose overrides it to 'postgres' for the
# containers, and this value is what host-run scripts need.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labelwise
POSTGRES_USER=labelwise
POSTGRES_PASSWORD=labelwise

# ── Ingestion ────────────────────────────────────────────────────────────────
MAX_PRODUCTS=5000
OFF_VERIFY_SSL=true

# ── Retrieval: starting points, to be replaced by YOUR measurements ───────────
RETRIEVAL_METHOD=hybrid
HYBRID_ALPHA=0.1
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=5
ENABLE_RERANK=true
ENABLE_QUERY_REWRITE=true

# ── Generation ───────────────────────────────────────────────────────────────
PROMPT_STRATEGY=basic
ENABLE_ONLINE_JUDGE=true

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000