{
  "uid": "labelwise-main",
  "title": "LabelWise - RAG Monitoring",
  "description": "Traffic, latency, answer quality, and cost for the LabelWise food-label assistant.",
  "tags": [
    "labelwise",
    "rag",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Requests over time",
      "description": "Query volume over time.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\ncount(*) AS \"requests\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Average response time",
      "description": "Mean end-to-end latency, including retrieval and generation.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\navg(response_time_ms) / 1000.0 AS \"avg seconds\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "P95 response time",
      "description": "95th percentile latency - the slow tail users actually feel.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\npercentile_cont(0.95) WITHIN GROUP (ORDER BY response_time_ms) / 1000.0 AS \"p95 seconds\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "User feedback",
      "description": "Thumbs up versus thumbs down.",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\nCASE WHEN feedback = 1 THEN 'Helpful' ELSE 'Not helpful' END AS \"metric\",\ncount(*) AS \"value\"\nFROM feedback\nWHERE $__timeFilter(timestamp)\nGROUP BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Answer relevance (LLM judge)",
      "description": "Online LLM-as-a-judge verdict on each answer.",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\ncoalesce(relevance, 'UNKNOWN') AS \"metric\",\ncount(*) AS \"value\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Numeric grounding over time",
      "description": "Fraction of numbers in each answer traceable to the retrieved products. A drop indicates fabricated nutrition values.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\navg(grounding_score) AS \"mean grounding\"\nFROM conversations\nWHERE $__timeFilter(timestamp) AND grounding_score IS NOT NULL\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Token usage over time",
      "description": "Token consumption split by stage.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\nsum(prompt_tokens)     AS \"prompt\",\nsum(completion_tokens) AS \"completion\",\nsum(eval_total_tokens) AS \"rewrite/rerank/judge\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Cumulative estimated cost",
      "description": "ESTIMATE ONLY: computed from real token counts at published list prices. The configured backend may be self-hosted and free.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n$__timeGroupAlias(timestamp, $__interval),\nsum(sum(estimated_cost_usd)) OVER (ORDER BY $__timeGroup(timestamp, $__interval))\n    AS \"cumulative USD\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Retrieval method: usage and latency",
      "description": "Comparison of retrieval configurations seen in production traffic.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\nretrieval_method                AS \"Method\",\ncount(*)                        AS \"Requests\",\nround(avg(response_time_ms)::numeric, 0)   AS \"Avg ms\",\nround(avg(retrieval_time_ms)::numeric, 1)  AS \"Retrieval ms\",\nround(avg(total_tokens)::numeric, 0)       AS \"Avg tokens\",\nround(100.0 * count(*) FILTER (WHERE relevance = 'RELEVANT') / count(*), 1)\n                                AS \"% relevant\"\nFROM conversations\nWHERE $__timeFilter(timestamp)\nGROUP BY retrieval_method\nORDER BY count(*) DESC",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Recent questions receiving negative feedback",
      "description": "Where the system is failing users - the queue to work through.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "labelwise-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "labelwise-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\nc.timestamp AS \"Time\",\nc.question  AS \"Question\",\nc.relevance AS \"Judge\",\nround(c.grounding_score::numeric, 2) AS \"Grounding\",\nc.retrieval_method AS \"Method\"\nFROM conversations c\nJOIN feedback f ON f.conversation_id = c.id\nWHERE $__timeFilter(c.timestamp) AND f.feedback = -1\nORDER BY c.timestamp DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
